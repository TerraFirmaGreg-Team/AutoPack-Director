{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TerraFirmaGreg-Team/AutoPack-Director/refs/heads/main/modules/core/src/main/resources/schemas/modify.schema.json",
  "title": "Modify local files",
  "type": "object",
  "required": [
    "folder"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
