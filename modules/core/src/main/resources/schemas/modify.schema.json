    },
    "folder": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "disable": {
      "type": "boolean"
    },
    "delete": {
      "type": "boolean"
    },
    "newFolder": {
      "type": "string"
    },
    "newFileName": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    }
  }
}
